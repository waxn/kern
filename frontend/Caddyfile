:80 {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy same-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		-Server
	}

	handle /api/* {
		reverse_proxy backend:8000
	}

	# Git smart HTTP (clone/fetch/push): stream both ways, no size limit, no buffering.
	@git path_regexp ^/git/[^/]+\.git/
	handle @git {
		reverse_proxy backend:8000 {
			flush_interval -1
			transport http {
				read_timeout 10m
				write_timeout 10m
			}
		}
	}

	# Uploaded files belong to the signed-in user, so the backend checks the session and serves
	# them from that user's own folder (with HTTP range support for audio, video and big PDFs).
	handle /media/* {
		reverse_proxy backend:8000 {
			flush_interval -1
			transport http {
				read_timeout 10m
				write_timeout 10m
			}
		}
	}

	handle {
		root * /srv
		@immutable path /_app/immutable/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
