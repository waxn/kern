# Copy to .env to override.
# The port Kern is served on. Pick something unusual; it is the only port Kern opens.
KERN_PORT=8420
# 0.0.0.0 = reachable from other devices (a server). Use 127.0.0.1 to keep Kern on this machine only,
# for example when a reverse proxy on the same host handles HTTPS.
KERN_BIND=0.0.0.0
# Set to 1 when Kern is reached over HTTPS (through a reverse proxy). Makes the session cookie Secure.
KERN_HTTPS=0
# Extra host names allowed to submit forms, comma separated. Only needed if your proxy rewrites the Host header.
KERN_TRUSTED_HOSTS=
