# Copy to .env to override. docker compose reads it from this folder; every value is optional.

# The port the web app is served on. Pick something unusual.
KERN_PORT=8420
# 0.0.0.0 = reachable from other devices (a server). Use 127.0.0.1 to keep Kern on this machine only,
# for example when a reverse proxy on the same host handles HTTPS. Applies to the SSH port too.
KERN_BIND=0.0.0.0
# Set to 1 when Kern is reached over HTTPS (through a reverse proxy). Makes the session cookie Secure.
KERN_HTTPS=0
# Extra host names allowed to submit forms, comma separated. Only needed if your proxy rewrites the Host header.
KERN_TRUSTED_HOSTS=

# Git over SSH (the "ssh" service; see docs/git-ssh.md).
# The port the SSH server is published on, also used in the ssh:// clone URLs Kern shows.
KERN_SSH_PORT=2222
# Host name for those clone URLs. Empty = the host you browse Kern with. Set it when SSH is reached
# under another name than the web app (e.g. the web app is behind a proxy, SSH goes straight to the box).
KERN_SSH_HOST=
